{
  "manifest_version": 3,
  "name": "Zimsmith",
  "version": "0.1.4",
  "description": "Crawl websites and build searchable offline ZIM archives entirely in your browser.",
  "permissions": ["unlimitedStorage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Zimsmith"
  },
  "icons": {
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; worker-src 'self'; base-uri 'none'"
  }
}
